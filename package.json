{
  "name": "remote-runner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "remote-runner": "./dist/src/main.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^10.8.0",
    "prettier": "3.9.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
